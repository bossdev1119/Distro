# Copy to .env.local and fill in. Never commit .env.local.

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL; used for magic-link redirects. Must be in Supabase Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API Keys) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…) — or the legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — or the legacy "service_role" key. SERVER ONLY: bypasses RLS.
SUPABASE_SECRET_KEY=

# ── LLM ──────────────────────────────────────────────────────────────────────
# Which LLM builds profiles (and later: scores, drafts, classifies). "gemini" (free tier) or "anthropic".
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Optional overrides. "-latest" aliases always point at Google's current Flash models.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FAST_MODEL=gemini-flash-lite-latest
# ── Embeddings (text → 768 numbers, matching the vector(768) columns) ──────────
# "local": open-source model on this machine via Transformers.js — free, no quota, ~100 MB
#          download on first use into .cache/transformers. "gemini": API, free tier 1,000 texts/day.
# Changing the model re-embeds everything automatically; re-measure relevanceThreshold after.
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=Xenova/bge-base-en-v1.5
GEMINI_MODEL_EMBED=gemini-embedding-001
# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ── YouTube Data API v3 (Milestone 2) ────────────────────────────────────────
# Free: console.cloud.google.com → enable "YouTube Data API v3" → Credentials → API key.
# 10,000 units/day; the app stops at 9,000 (lib/config.ts). Restrict the key to this API.
YOUTUBE_API_KEY=

# ── Page fetching (Jina Reader) ──────────────────────────────────────────────
# Optional. Works without a key at a lower rate limit.
JINA_API_KEY=

# ── Inngest ──────────────────────────────────────────────────────────────────
# Local dev: set INNGEST_DEV=1 and run `npm run inngest`. Production: unset INNGEST_DEV and set both keys.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Later milestones (not used yet) ──────────────────────────────────────────
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One of:
TAVILY_API_KEY=
SERPER_API_KEY=
